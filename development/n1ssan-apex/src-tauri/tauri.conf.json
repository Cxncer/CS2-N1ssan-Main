{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "N1ssan Sync",
  "version": "0.1.0",
  "identifier": "com.n1ssan.apex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "N1ssan Sync",
        "width": 250,
        "height": 250,
        "minWidth": 250,
        "minHeight": 250,
        "maxWidth": 250,
        "maxHeight": 250,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": ["../definitions/offsets.json"]
  }
}
